// COOP'APPLI — Schéma de base de données PostgreSQL (Prisma)
// Correspond au modèle défini section 3.2 du cahier des charges

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  groups Group[]

  @@map("users")
}

enum GroupStatus {
  OPEN
  CLOSED
}

model Group {
  id            String      @id @default(uuid())
  ownerId       String      @map("owner_id")
  title         String
  description   String?
  targetAmount  Decimal     @map("target_amount") @db.Decimal(14, 2)
  currency      String      @default("XOF")
  status        GroupStatus @default(OPEN)
  // Instructions affichées sur la page publique (ex: numéro Mobile Money de l'admin)
  paymentInstructions String? @map("payment_instructions")
  // Jeton opaque utilisé dans le lien public /c/:shareToken — ne jamais utiliser l'id interne
  shareToken    String      @unique @default(uuid()) @map("share_token")
  createdAt     DateTime    @default(now()) @map("created_at")

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@map("groups")
  @@index([ownerId])
}

model GroupMember {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  displayName String   @map("display_name")
  phone       String?
  // Rempli uniquement en mode "cotisation fixe" : somme exacte que ce membre doit verser.
  // Laissé vide en mode "libre" : le statut "à jour" se base alors sur l'existence d'au moins un versement.
  expectedAmount Decimal? @map("expected_amount") @db.Decimal(14, 2)
  joinedAt    DateTime @default(now()) @map("joined_at")

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@map("group_members")
  @@index([groupId])
}

model Contribution {
  id            String   @id @default(uuid())
  groupId       String   @map("group_id")
  memberId      String   @map("member_id")
  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method") // espèces, virement, mobile money (saisie manuelle)
  notes         String?

  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("contributions")
  @@index([groupId])
  @@index([memberId])
}
