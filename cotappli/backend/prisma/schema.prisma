// COOP'APPLI — Schéma de base de données PostgreSQL (Prisma)
// Correspond au modèle défini section 3.2 du cahier des charges

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  createdAt    DateTime @default(now()) @map("created_at")

  groups Group[]

  @@map("users")
}

model Group {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  title         String
  description   String?
  targetAmount  Decimal  @map("target_amount") @db.Decimal(14, 2)
  currency      String   @default("XOF")
  createdAt     DateTime @default(now()) @map("created_at")

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@map("groups")
  @@index([ownerId])
}

model GroupMember {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  displayName String   @map("display_name")
  phone       String?
  joinedAt    DateTime @default(now()) @map("joined_at")

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@map("group_members")
  @@index([groupId])
}

model Contribution {
  id            String   @id @default(uuid())
  groupId       String   @map("group_id")
  memberId      String   @map("member_id")
  amount        Decimal  @db.Decimal(14, 2)
  paymentDate   DateTime @map("payment_date")
  paymentMethod String?  @map("payment_method") // espèces, virement, mobile money (saisie manuelle)
  notes         String?

  member GroupMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("contributions")
  @@index([groupId])
  @@index([memberId])
}
