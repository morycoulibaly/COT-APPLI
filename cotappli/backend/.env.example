# Connexion PostgreSQL (Neon ou Supabase — copier la connection string depuis le dashboard)
DATABASE_URL="postgresql://user:password@host:5432/coopappli?sslmode=require"

# Secret utilisé pour signer les JWT — générer une valeur forte et aléatoire en production
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

PORT=3001

# Origine autorisée pour CORS (URL du frontend Vercel)
FRONTEND_URL="http://localhost:3000"
